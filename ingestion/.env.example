# URLs de scraping - use term=desenvolvedor para focar em vagas de desenvolvimento
# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA commite credenciais reais no controle de versão

SCRAPER_URLS=https://portal.gupy.io/job-search/term=desenvolvedor,https://www.catho.com.br/vagas/desenvolvedor/

# Feeds RSS do We Work Remotely, separados por vírgula.
# As vagas mantêm atribuição e link para o anúncio original.
SCRAPER_RSS_URLS=https://weworkremotely.com/categories/remote-programming-jobs.rss

# Configuração do banco de dados
# Para Supabase Direct Connection (porta 5432):
# DB_HOST=db.seu-projeto-ref.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=sua-senha

# Para Supabase Pooler (porta 6543) - IPv4:
# DB_HOST=aws-0-us-east-2.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.seu-projeto-ref
# DB_PASSWORD=sua-senha

# Para desenvolvimento local (Docker):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=techedin
DB_USER=postgres
DB_PASSWORD=postgres

# SSL mode: require (Supabase) ou disable (local)
DB_SSLMODE=disable

# Novas fontes públicas. Remotive: atraso de 24h e cache mínimo de 6 horas.
SCRAPER_REMOTIVE_ENABLED=true
# Nubank: canal oficial Ashby; anúncios públicos com tecnologias reconhecidas.
SCRAPER_NUBANK_ENABLED=true
# Cache local de frequência/falhas. Em Docker, monte um volume persistente.
# SCRAPER_CACHE_DIR=/app/.cache/ingestion
